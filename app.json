{
  "expo": {
    "name": "BHS Mobil",
    "slug": "bhs-mobil",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.bhsmobil.app",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleDisplayName": "BHS MOBİL"
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1b2f55",
        "backgroundImage": "./assets/android-icon-background.png",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.bhsmobil.app",
      "versionCode": 1
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "Bildirilere fotoğraf eklemek için galerinize erişim gerekir.",
          "cameraPermission": "Bildirilere fotoğraf çekmek için kameranıza erişim gerekir.",
          "microphonePermission": false
        }
      ],
      "expo-sharing",
      [
        "./plugins/withAppLabel",
        {
          "label": "BHS MOBİL"
        }
      ]
    ],
    "scheme": "bhsmobil",
    "backgroundColor": "#111113",
    "extra": {
      "eas": {
        "projectId": "837c4f18-d2c3-458a-8a20-a7f306e9d160"
      }
    },
    "owner": "orhankesk57"
  }
}
